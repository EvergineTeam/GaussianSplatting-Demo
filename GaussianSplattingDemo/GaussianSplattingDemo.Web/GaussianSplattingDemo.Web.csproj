<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">false</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <BlazorEnableCompression Condition="'$(Configuration)' == 'Debug'">false</BlazorEnableCompression>
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- <AOTMode>LLVMOnly</AOTMode> -->
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="link-descriptor.xml" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>WASM</DefineConstants>
    <GenerateEvergineContent>False</GenerateEvergineContent>
    <GenerateEvergineAssets>True</GenerateEvergineAssets>
    <WasmAllowUndefinedSymbols>True</WasmAllowUndefinedSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Evergine.GaussianSplatting.Web" Version="2026.9.29.336-nightly" />
    <PackageReference Include="Evergine.Framework" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.HLSLEverywhere" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.OpenGL" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.Serialization.Converters" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.Targets" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.Targets.Web" Version="2026.11.5.670-nightly" />
    <PackageReference Include="Evergine.Web" Version="2026.11.5.670-nightly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GaussianSplattingDemo\GaussianSplattingDemo.csproj" />
  </ItemGroup>
</Project>